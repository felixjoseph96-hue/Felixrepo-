# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///apartments.db

# ─── Email Notifications (optional but recommended) ───────────────────────────
# For Gmail: enable 2FA then generate an App Password at
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password_here
NOTIFY_EMAIL=your@email.com

# ─── RentCast API (recommended — works anywhere, no browser needed) ───────────
# Free tier: 50 requests/month. Sign up at https://app.rentcast.io
# When set, RentCast is used as the primary data source.
RENTCAST_API_KEY=

# ─── Scraper Behaviour ────────────────────────────────────────────────────────
# How often to check for new listings (minutes)
SCRAPE_INTERVAL_MINUTES=30

# Run browsers in headless mode (true/false). Set false to debug.
HEADLESS=true

# Max listings to deep-inspect per scraper run (avoids rate-limiting)
MAX_DETAIL_PAGES=20

# ─── Search Criteria ─────────────────────────────────────────────────────────
MAX_PRICE=3500
MIN_BEDROOMS=2
MIN_BATHROOMS=2
MIN_SQFT=1000
MAX_METRO_WALK_MILES=0.5
