# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///physician_insights.db

# ─── Claude (pain-point extraction + insight synthesis) ───────────────────────
# Required. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ─── Audio transcription (optional - only needed if you upload audio files) ───
# Option A: OpenAI Whisper API - fast, no local model download.
OPENAI_API_KEY=
# Option B: local faster-whisper (used automatically when OPENAI_API_KEY is
# unset and `pip install faster-whisper` has been run). Model size: tiny/base/
# small/medium/large-v3.
LOCAL_WHISPER_MODEL=base

# ─── Uploads ────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200
